# Copy to .env.production in a private directory on the PC, alongside
# fullchain.pem and privkey.pem. scripts/deploy.ps1 provisions it once.
DOMAIN=euredinteplast.local.eurecat.org
PROJECT_NAME=INTEPLAST
STACK_NAME=inteplast
DOCKER_IMAGE_BACKEND=inteplast-backend
DOCKER_IMAGE_FRONTEND=inteplast-frontend
ENVIRONMENT=production
FRONTEND_HOST=https://euredinteplast.local.eurecat.org
SECRET_KEY=
FIRST_SUPERUSER=
FIRST_SUPERUSER_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app
POSTGRES_PORT=5432
BACKEND_CORS_ORIGINS=https://euredinteplast.local.eurecat.org
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SENTRY_DSN=

# Preserve the dataset ID when restoring an existing catalogue.
ASSETS_SOURCE_ID=
ASSETS_SOURCE_NAME=Exemples
# An empty drive ID uses the signed-in user's OneDrive (single-user pilot).
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_PATH=Escritorio/proyectos/11. inteplast/Exemples
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
