# Copy this file to .env once per installation. .env is private and ignored by Git.
# Docker Compose loads .env automatically from the repository root.

DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME="INTEPLAST"
STACK_NAME=inteplast

BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
# Development examples only; replace these before deploying.
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
ALLOW_PUBLIC_SIGNUP=false
ENABLE_TEST_ROUTES=false

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
SENTRY_DSN=

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Optional local assistant. Ollama runs on the Windows host, not in the container.
ASSISTANT_ENABLED=false
ASSISTANT_OLLAMA_URL=http://host.docker.internal:11434
ASSISTANT_MODEL=qwen3.5:2b
ASSISTANT_CONTEXT_TOKENS=8192
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=120
ASSISTANT_SEMANTIC_ENABLED=true
ASSISTANT_EMBEDDING_MODEL=embeddinggemma
ASSISTANT_EMBEDDING_DIMENSIONS=768
ASSISTANT_SEMANTIC_MIN_SIMILARITY=0.24
ASSISTANT_EMBEDDING_TIMEOUT_SECONDS=30
ASSISTANT_INDEX_INTERVAL_SECONDS=60

# Optional local originals, mounted read-only. Uncomment all five lines and
# set an existing folder outside this repository. Windows paths should use /.
# Keep ASSETS_SOURCE_ID unchanged when moving an already linked dataset.
# Without this block the app runs with uploads and no external source.
# COMPOSE_PATH_SEPARATOR=|
# COMPOSE_FILE=compose.yml|compose.override.yml|compose.assets.yml
# ASSETS_HOST_PATH=C:/data/Exemples
# ASSETS_SOURCE_ID=development-parts
# ASSETS_SOURCE_NAME=Piezas de ejemplo
